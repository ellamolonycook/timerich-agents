# Time Rich runtime agents - example environment.
# Copy to .env and fill in locally. NEVER commit a populated .env.
# Every value below is a placeholder; no real credential belongs in this file.

# --- Runtime ---
TIMERICH_ENV=development           # development | staging | production
TIMERICH_LOG_LEVEL=info            # debug | info | warn | error
TIMERICH_DRY_RUN=true              # when true, connectors must not perform real side effects

# --- Approval boundary ---
# Outbound sends are blocked until an approval decision is recorded.
TIMERICH_APPROVAL_TTL_MINUTES=1440

# --- Connector credentials (placeholders only, not wired up yet) ---
# Names referenced by agent manifests via SecretRef. No real values here, ever.
# EMAIL_PROVIDER_API_KEY=
# PODCAST_PROSPECT_SOURCE_API_KEY=

# Provider-specific credentials, for when those connectors are built:
# INSTANTLY_API_KEY=
# ZEROBOUNCE_API_KEY=
# RESEND_API_KEY=
# WHATSAPP_ACCESS_TOKEN=
# LINKEDIN_ACCESS_TOKEN=
