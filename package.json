{
  "name": "timerich-agents",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Runtime agents and shared infrastructure for Time Rich.",
  "engines": {
    "node": ">=20.11"
  },
  "workspaces": [
    "packages/*",
    "agents/*"
  ],
  "scripts": {
    "build": "tsc --build",
    "clean": "tsc --build --clean",
    "typecheck": "tsc --build --force && tsc -p tsconfig.test.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm run test"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
